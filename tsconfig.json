{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        // 🛡️ STRICTNESS LEVEL 100 🛡️
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,

        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@camp_candor/000.agent": ["./packages/000.agent/BEE.ts"]
        }
    },
    "files": ["vitest.config.ts"],
    "exclude": ["node_modules", "dist"],
    "references": [{ "path": "./packages/000.agent" }]
}
