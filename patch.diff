+) {
+    switch (act.type) {
+        case Act.UPDATE_INPUT:
+            return Buzz.updateInput(clone(model), act.bale, state)
+
+        case Act.INIT_INPUT:
+            return Buzz.initInput(clone(model), act.bale, state)
+
+        case Act.OPEN_INPUT:
+            return Buzz.openInput(clone(model), act.bale, state)
+
+        default:
+            return model
+    }
+}
