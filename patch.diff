+    echo "${{ secrets.AI_GATEWAY_TOKEN }}" | npx wrangler secret put AI_GATEWAY_TOKEN --env staging
+
+    # 2. Pipe GitHub runtime token to Cloudflare secret store
+    echo "$RUNTIME_GITHUB_TOKEN" | npx wrangler secret put GITHUB_TOKEN --env staging
+
+    # 3. Pipe Jules API Key to Cloudflare secret store
+    echo "${{ secrets.JULES_API_KEY }}" | npx wrangler secret put JULES_API_KEY --env staging
+
+    # 4. Deploy Worker and pass non-sensitive GITHUB_DEFAULT_OWNER via --var
+    npx wrangler deploy --env staging --var GITHUB_DEFAULT_OWNER:"$DEFAULT_OWNER"
+  env:
+    CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+    CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+    RUNTIME_GITHUB_TOKEN:
+      ${{ secrets.REPO_BOT_GITHUB_TOKEN || secrets.GITHUB_TOKEN }}
+    DEFAULT_OWNER: ${{ vars.GITHUB_DEFAULT_OWNER || 'camp-candor' }}
+```
+
+---
+
+### IV. FALSIFIABLE ACCEPTANCE CRITERIA (ATTENTION BOTTOM ANCHOR)
+
+Before pushing commits or opening a Pull Request, execute these commands in
+exact sequence and confirm exit code 0:
+
+1. `npm run check` (TypeScript project references must compile with zero errors
+   across all workspaces).
+2. `npm run test:worker` (Worker unit and gateway tests must pass).
+3. `npm run test:jules` (Unit test suite in `packages/823.jules` must pass with
+   code 0).
+4. `git status -s` (Assert that ZERO files in `apps/995.library/` have been
+   added, modified, or deleted).
+
+```
