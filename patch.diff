+}
+
+export type Actions =
+    | InitCollect
+    | UpdateCollect
+    | ReadCollect
+    | WriteCollect
+    | CreateCollect
+    | EmptyCollect
+    | FetchCollect
+    | DeleteCollect
+    | RemoveCollect
+    | ModelCollect
