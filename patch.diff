+    setTimeout(() => updateMenu(cpy, bal, ste), 300)
+    return cpy
+  }
+
+  switch (src) {
+    case ActOlm.UPDATE_agent.split(']')[1]:
+      bit = await ste.hunt(ActOlm.UPDATE_agent, {
+        content: 'agent Menu Selected',
+      })
+      bit = await global.LIBRARY.hunt(PRINT_MENU, bit)
