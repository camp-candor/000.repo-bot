+    readonly type = EMPTY_COLLECT
+    constructor(public bale: CollectBit) {}
+}
+
+export const MODEL_COLLECT = '[Empty action] Model Collect'
+export class ModelCollect implements Action {
+    readonly type = MODEL_COLLECT
