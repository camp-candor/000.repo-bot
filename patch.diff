+'use server'
+
+import * as Import from './BEE.js'
+import State from './99.core/state.js'
+
+var dex = 0
+
+let instance = null
+
+var sim = {
+    hunt: (a, b) => {},
+    state: null,
+}
+
+sim.hunt = (typ, obj) => {
+    return host(obj, typ)
+}
+
+var host = (obj, typ) => {
+    init()
+
+    var slv
+    const promo = new Promise((rslv, rjct) => (slv = rslv))
+
+    if (obj == null) obj = {}
+    if (obj.slv == null) obj.slv = (val0) => slv(val0)
+
+    sim.state.dispatch({ type: typ, bale: obj })
+    return promo
+}
+
+var init = () => {
+    if (!instance) {
+        if (sim.state != null) return
+        sim.state = new State()
+        sim.state.pivot = sim
+        sim.state.hunt = sim.hunt
+        for (var k in Import.list) new Import.list[k](sim.state)
+        instance = sim
+    }
+
+    return instance
+}
+
+export const repobot = async (typ, obj) => {
+    return sim.hunt(typ, obj)
+}
diff --git a/packages/821.repobot/97.collect.unit/buz/collect.buzz.ts b/packages/821.repobot/97.collect.unit/buz/collect.buzz.ts
