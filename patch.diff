+        prompt: body.prompt || '',
+      },
+      c.env,
+    )
+    return c.json(result)
+  } catch (err: any) {
+    return c.json({ error: err.message }, 500)
+  }
+})
+
+app.get('/api/jules/session/:id', async (c) => {
+  try {
+    const id = c.req.param('id')
+    const session = await getJulesSession(id, c.env)
