+            break
+
+        case ActGer.LORE_GEARS.split(']')[1]:
+            bit = await ste.hunt(ActGrd.UPDATE_GRID, {
+                x: 0,
+                y: 4,
+                xSpan: 4,
+                ySpan: 6,
+            })
+            bit = await ste.hunt(ActPut.OPEN_INPUT, {
