{
    "name": "repo-bot-00",
    "version": "0.0.3",
    "type": "module",
    "private": true,
    "description": "BILLI FAE BOTS",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "//__ 🛑 GUARDRAILS _______________________": "",
        "commit": "echo '❌ STOP: Use `git commit -m \"type: msg\"` directly.' && exit 1",
        "commit:human": "npm run commit:before && npx git-cz",
        "//__ 🚀 DEV (Parallel) ___________________": "",
        "dev": "npm run dev --workspace=@camp_candor/995.library",
        "dev:note": "echo 'ℹ️ AGENT: When creating new apps, add them to the dev script above.'",
        "lib": "npx tsx run.ts -t pivot",
        "//__ 🏗️ BUILD (Type Safe) ________________": "",
        "build": "npm run build --workspaces --if-present",
        "build:force": "npm run build --workspaces --if-present --force",
        "//__ 🐊 TESTING ______________________": "",
        "test": "npm run test:worker && npm run test:sower",
        "test:worker": "npm run test --workspace=@camp_candor/agent",
        "test:sower": "npm run test --workspace=@camp_candor/995.library",
        "test:agent": "npm run test --workspace=@camp_candor/000.agent",
        "test:repobot": "npm run test --workspace=@camp_candor/821.repobot",
        "test:cloudflare": "npm run test --workspace=@camp_candor/133.cloudflare",
        "test:jules": "npm run test --workspace=@camp_candor/135.jules",
        "test:github": "npm run test --workspace=@camp_candor/132.github",
        "test:slack": "npm run test --workspace=@camp_candor/924.slack",
        "test:audit": "npm run test:audit --workspace=@camp_candor/agent",
        "audit:local": "npm run test:audit:local --workspace=@camp_candor/agent",
        "audit:staging": "npm run test:audit:staging --workspace=@camp_candor/agent",
        "verify:local": "start-server-and-test dev http://127.0.0.1:8787 audit:local",
        "//__ 🛠️ MAINTENANCE ______________________": "",
        "prepare": "husky",
        "commit:before": "npm run build && npm run lint:staged",
        "//__ 🧹 CODE QUALITY ______________________": "",
        "check": "npm run check:all",
        "fix": "npm run fix:all",
        "check:all": "npm run prettier:check && npm run lint:check",
        "fix:all": "npm run prettier:fix && npm run lint:fix",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:staged": "npx lint-staged --relative --debug",
        "prettier:check": "prettier . --check --ignore-path .gitignore",
        "prettier:fix": "prettier . --write --ignore-path .gitignore",
        "//__ 📦 VERSIONING _______________________": "",
        "changeset": "npx changeset",
        "version": "npx changeset version && npm install",
        "//__ ☢️ RESET ____________________________": "",
        "clean": "npm run clean:dist && npm run clean:ts",
        "clean:dist": "find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
        "clean:ts": "find . -name '*.tsbuildinfo' -type f -delete",
        "uninstall": "npm run clean && rm -f package-lock.json && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
        "reset": "npm run uninstall && npm install && npm run build",
        "//__ 🚢 SHIP ____________________________": "",
        "ship": "npm run build && npm run deploy --workspace=@camp_candor/agent -- --env staging && npm run audit:staging"
    },
    "lint-staged": {
        "*.{js,ts,tsx,json,css,md}": [
            "prettier --write"
        ],
        "*.{js,ts,tsx}": [
            "eslint --fix --no-warn-ignored"
        ]
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.12.1",
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "@eslint/js": "9.39.5",
        "@types/clone-deep": "4.0.4",
        "@types/dot": "1.1.7",
        "@types/rx-lite": "4.0.10",
        "@types/string": "0.0.34",
        "@vitest/ui": "3.2.4",
        "clone-deep": "4.0.1",
        "commander": "^13.1.0",
        "commitizen": "^4.3.0",
        "concurrently": "^8.2.0",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^16.6.1",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "markdownlint-cli2": "^0.13.0",
        "playwright-core": "1.57.0",
        "prettier": "^3.0.0",
        "rx-lite": "4.0.8",
        "start-server-and-test": "2.1.3",
        "string": "3.3.3",
        "tsconfig-paths": "4.2.0",
        "tsx": "^4.7.0",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "3.2.4",
        "zod": "^3.22.0"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "packageManager": "npm@10.9.2",
    "dependencies": {
        "lodash": "4.18.1"
    }
}
