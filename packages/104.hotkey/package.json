{
    "name": "@camp_candor/104.hotkey",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "main": "BEE.ts",
    "exports": {
        ".": {
            "types": "./BEE.ts",
            "import": "./BEE.ts",
            "require": "./BEE.ts",
            "default": "./BEE.ts"
        },
        "./hunt": {
            "types": "./hunt.ts",
            "import": "./hunt.ts",
            "require": "./hunt.ts",
            "default": "./hunt.ts"
        }
    },
    "scripts": {
        "test": "ava"
    },
    "ava": {
        "files": [
            "test/**/*.test.ts"
        ],
        "extensions": {
            "ts": "commonjs",
            "tsx": "commonjs"
        },
        "nodeArguments": [
            "--import=tsx"
        ]
    }
}
