{
    "extends": "../../apps/995.library/tsconfig-base.json",
    "compilerOptions": {
        "outDir": "../dist/821.repobot",
        "composite": true,
        "skipLibCheck": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "noUnusedLocals": false,
