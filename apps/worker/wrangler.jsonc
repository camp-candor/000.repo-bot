{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "npm-agent-01",
    "main": "src/index.ts",
    "compatibility_date": "2026-01-07",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
    },
    "ai": {
        "binding": "AI",
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "REPO_BOT_DO",
                "class_name": "RepoBotDO",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_classes": ["RepoBotDO"],
        },
        {
            "tag": "v2",
            "deleted_classes": ["RepoBotDO"],
            "new_sqlite_classes": ["RepoBotDO"],
        },
    ],
    "env": {
        "staging": {
            "name": "repo-bot-00",
            "ai": {
                "binding": "AI",
            },
            "durable_objects": {
                "bindings": [
                    {
                        "name": "REPO_BOT_DO",
                        "class_name": "RepoBotDO",
                    },
                ],
            },
            "migrations": [
                {
                    "tag": "v1",
                    "new_classes": ["RepoBotDO"],
                },
                {
                    "tag": "v2",
                    "deleted_classes": ["RepoBotDO"],
                    "new_sqlite_classes": ["RepoBotDO"],
                },
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "repo-bot-d1",
                    "database_id": "00000000-0000-0000-0000-000000000000",
                },
            ],
            "triggers": {
                "crons": ["0 0 * * *"],
            },
        },
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "repo-bot-d1",
            "database_id": "00000000-0000-0000-0000-000000000000",
        },
    ],
    "triggers": {
        "crons": ["0 0 * * *"],
    },
}
