# Cloudflare Workers AI & AI Gateway
CLOUDFLARE_ACCOUNT_ID="your_account_id_here"
CLOUDFLARE_API_TOKEN="your_workers_ai_api_token"
CLOUDFLARE_AI_GATEWAY="repo-bot-gateway"

# GitHub REST API Token (Fine-grained PAT or App Installation Token)
# Required permissions: Contents (Read & Write), Pull Requests (Read & Write), Commit Statuses (Read & Write)
GITHUB_TOKEN="ghp_yourPersonalAccessTokenOrAppToken"
GITHUB_DEFAULT_OWNER="camp-candor"
GH_WEBHOOK_SECRET="super-secret-webhook-key"

# Jules Coding Agent API Key
JULES_API_KEY="your-jules-api-token"

# Slack Review Bridge & Approval Gate (FEAT-04)
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...) with chat:write, chat:write.public scopes
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"

# SLACK_SIGNING_SECRET: App Signing Secret from Slack App Settings -> Basic Information
SLACK_SIGNING_SECRET="your_slack_signing_secret_here"

# SLACK_CHANNEL_ID: Slack channel ID for interactive approval cards (e.g. C0123456789 or #ops-bridge)
SLACK_CHANNEL_ID="#ops-bridge"

# SLACK_AUTHORIZED_APPROVERS: Comma-separated Slack User IDs permitted to approve high-risk merges
SLACK_AUTHORIZED_APPROVERS="U01234567,U89012345"
